# Vorlage für .env – kopieren nach .env und Platzhalter ersetzen. .env nie committen.

# Adresse der Forgejo-Instanz, wie der Bot sie erreicht (ohne / am Ende)
FORGEJO_URL=https://forgejo.example
# Organisation, deren Repos der Bot pflegt
FORGEJO_ORG=beispiel-org

# Eigenes Konto des Bots: Schreibrecht auf die Repos (Team), kein Administrator, keine Zwei-Faktor-Anmeldung
BOT_BENUTZER=board-bot
BOT_PASSWORT=hier-das-passwort-des-bot-kontos
# Optional: API-Token des Bot-Kontos (Bereiche read:organization, read:issue, read:repository).
# Leer = der Bot liest die API mit Benutzername und Passwort.
BOT_TOKEN=

# Secret des Organisations-Webhooks, mindestens 24 Zeichen (z. B. openssl rand -hex 32)
WEBHOOK_SECRET=hier-ein-langes-zufaelliges-secret

# Abgleich aller Repos alle n Minuten (0 = aus); Vorgabe 15
ABGLEICH_MINUTEN=15
# Optional: Repo für den Selbsttest; leer = erstes Repo mit offenem Projekt
SELBSTTEST_REPO=

# Nur für docker-compose: auf welcher Adresse und welchem Port der Host den Bot anbietet.
# 127.0.0.1 reicht, wenn Forgejo auf demselben Host läuft und den Bot über diese Adresse ruft.
BOT_BINDUNG=192.0.2.10
BOT_PORT=8080
